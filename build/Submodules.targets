<Project>
  <!-- AberrationCalculator is a git submodule. A clone made without the recursive option leaves
       external/AberrationCalculator empty, and the build would fail on the missing projects, so
       fetch it here before restore needs it. -->
  <PropertyGroup>
    <_GhostRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_GhostRepoRoot>
    <_AberrationCalculatorProject>$(_GhostRepoRoot)\external\AberrationCalculator\src\AberrationCalculator.Core\AberrationCalculator.Core.csproj</_AberrationCalculatorProject>
  </PropertyGroup>

  <Target Name="FetchAberrationCalculator"
          BeforeTargets="_LoadRestoreGraphEntryPoints;_GenerateRestoreProjectPathWalk;ResolveProjectReferences;Build"
          Condition="!Exists('$(_AberrationCalculatorProject)')">
    <Error Condition="!Exists('$(_GhostRepoRoot)\.git')"
           Text="AberrationCalculator is missing from external/AberrationCalculator, and this is not a git checkout, so it cannot be fetched. Clone with `git clone --recursive https://github.com/jaruiz6363/GhostAnalysis.git` (a GitHub ZIP download does not include submodules)." />
    <Message Importance="high" Text="Fetching the AberrationCalculator submodule (git submodule update --init)..." />
    <Exec Command="git submodule update --init" WorkingDirectory="$(_GhostRepoRoot)" />
  </Target>
</Project>
